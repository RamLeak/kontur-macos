{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Only the bundled main window may use the local native bridge.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "allow-local-api-request", "allow-local-import-preview", "allow-local-import-confirm",
    "allow-local-export-bundle", "allow-codex-status", "allow-codex-login", "allow-confirm-close"
  ]
}
